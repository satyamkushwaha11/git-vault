# Create an OAuth app: https://github.com/settings/developers
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Generate with: npx auth secret
AUTH_SECRET=

# ── Production only ────────────────────────────────────────────────
# A GitHub OAuth App allows exactly ONE callback URL, so production needs its
# own OAuth app (with its own ID/secret above) rather than a second callback
# added to the dev one.
#
# AUTH_URL=https://your-app.com     # https, no trailing slash
# AUTH_TRUST_HOST=true              # needed off Vercel (Railway, Render, Fly, VPS)
